APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Supabase direct connection (IPv6) or pooled connection (IPv4)
SUPABASE_DB_URL=postgresql+psycopg://postgres:<URL_ENCODED_PASSWORD>@db.amzllkpjwzqjrvudqxie.supabase.co:5432/postgres
ALLOW_LOCAL_SQLITE=false
# Alternative IPv4 connection pooler URL:
# SUPABASE_DB_URL=postgresql+psycopg://postgres.amzllkpjwzqjrvudqxie:<URL_ENCODED_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://amzllkpjwzqjrvudqxie.supabase.co
SUPABASE_JWT_SECRET=

MOCK_BANK_BASE_URL=http://127.0.0.1:9000
MOCK_BANK_DATABASE_PATH=backend/mock_bank/bank.sqlite
MOCK_BANK_AUTH_TOKEN=keeper-mock-bank-dev-token

# ArmorIQ Configuration
ARMORIQ_ENFORCEMENT=required
ARMORIQ_API_KEY=
ARMORIQ_MCP_NAME=keeper-payments
ARMORIQ_ROUTE=proxy
KEEPER_MCP_PUBLIC_URL=
KEEPER_MCP_INBOUND_SECRET=
ARMORIQ_MCP_KEEPER_PAYMENTS_AUTH_TYPE=bearer
ARMORIQ_MCP_KEEPER_PAYMENTS_TOKEN=

# Local seed household; runtime access is bound to signed authenticated-user context.
MCP_AGENT_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000001
HARD_PAYMENT_LIMIT=100000.00

# CORS allowed origins (comma-separated, include local dev ports like 8080 and 8081)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:5173,http://127.0.0.1:3000

# Authentication & Session Security
AUTH_JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
AUTH_TOKEN_EXPIRE_HOURS=24
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin
DEMO_ADMIN_JWT_SECRET=keeper-demo-admin-secret

# Gemini LLM (required for agent chat)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

